# =============================================================================
# Bull Trading Bot — Environment Variables
# =============================================================================
# IMPORTANT: In production (Claude Cloud Routines), these are set in the
# "trading" Cloud Environment in Claude Desktop, NOT in a .env file.
# This file is for local-only testing.
# =============================================================================

# --- Broker (Phase 1: Alpaca Paper) ---
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ACTIVE_BROKER=alpaca

# --- Broker (Phase 2: IBKR Live, ab Woche 4) ---
# IBKR_GATEWAY_HOST=your.vps.host
# IBKR_GATEWAY_PORT=4001
# IBKR_CLIENT_ID=1
# IBKR_ACCOUNT_ID=U1234567

# --- Research (Gemini = default, free 1500 req/day; Tavily = deep_research only) ---
GEMINI_API_KEY=your_google_ai_studio_key
TAVILY_API_KEY=tvly-your_tavily_key
# Optional fallback (not used by default — only if you re-enable Perplexity manually):
# PERPLEXITY_API_KEY=pplx-your_key_here

# --- Notifications ---
CALLMEBOT_API_KEY=your_callmebot_key
WHATSAPP_PHONE=491701234567

# --- Git Auto-Commit (only used inside routines) ---
GIT_AUTHOR_NAME=Bull Bot
GIT_AUTHOR_EMAIL=bot@trading.local
